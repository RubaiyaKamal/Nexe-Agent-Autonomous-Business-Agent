# =============================================================================
# Nexe Agent — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — free hosted: https://neon.tech  (New Project → Connection string)
# Select "Prisma" format then swap the prefix to postgresql+asyncpg://
# Example: postgresql+asyncpg://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx-yyy.REGION.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Redis — free hosted: https://upstash.com  (Create Database → .env tab → UPSTASH_REDIS_URL)
# Use the rediss:// (with double s) URL — Celery supports it natively.
# Example: rediss://default:password@xxx-xxx.upstash.io:6379
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:PASSWORD@xxx-xxx.REGION.upstash.io:6379

# -----------------------------------------------------------------------------
# OpenAI  — https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# -----------------------------------------------------------------------------
# Tavily (web search for data_retrieval tasks) — https://tavily.com
# Free tier: 1,000 searches/month
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-key-here

# -----------------------------------------------------------------------------
# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Agent behaviour (optional overrides)
# -----------------------------------------------------------------------------
TASK_TIMEOUT_SECONDS=60
LOG_RETENTION_DAYS=90
AUTO_EXECUTE_DEFAULT=false

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# Observability (optional — leave blank to disable)
OTLP_ENDPOINT=
